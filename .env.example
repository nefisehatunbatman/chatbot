# --- ZORUNLU ---
# OpenRouter anahtarı (https://openrouter.ai/keys). ASLA GitHub'a koyma.
OPENROUTER_API_KEY=sk-or-v1-...

# Kayıt olmak için gereken davet kodu. Bilmeyen kayıt olamaz.
INVITE_CODE=uzun-ve-tahmin-edilemez-bir-kod

# Admin hesabının kullanıcı adı. Bu kullanıcı pro yetkisi dağıtır (admin her zaman pro'dur).
ADMIN_USERNAME=senin-kullanici-adin

# Kullanıcıların API anahtarlarını şifrelemek için gizli metin (en az 16 karakter).
# Bir kez belirle, DEĞİŞTİRME: değişirse kayıtlı anahtarlar okunamaz, kullanıcılar yeniden girer.
KEYS_SECRET=en-az-16-karakterlik-rastgele-bir-metin

# Postgres bağlantısı. Vercel'de Neon eklediğinde OTOMATİK gelir, elle yazma.
DATABASE_URL=postgres://...

# --- İSTEĞE BAĞLI ---
# Vercel Blob eklediğinde OTOMATİK gelir. Yoksa dosyalar veritabanında tutulur (en fazla 4 MB).
BLOB_READ_WRITE_TOKEN=
# Blob deposunu "Public" oluşturduysan public yaz. Varsayılan: private
BLOB_ACCESS=private

# Varsayılan model (boşsa önerilen ilk ücretsiz model)
DEFAULT_MODEL=
# Önerilen listeyi elle belirlemek istersen (virgülle)
RECOMMENDED_FREE=
RECOMMENDED_PAID=
