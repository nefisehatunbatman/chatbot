# OpenRouter'dan aldığın anahtar (https://openrouter.ai/keys). ASLA GitHub'a koyma.
OPENROUTER_API_KEY=sk-or-v1-...

# Siteye girerken sorulacak şifre. Boş bırakırsan site açılmaz (bakiye koruması).
ACCESS_PASSWORD=uzun-ve-tahmin-edilemez-bir-sifre

# (İsteğe bağlı) Çerez imzası için rastgele bir metin
AUTH_SECRET=rastgele-uzun-bir-metin

# (İsteğe bağlı) Varsayılan model
DEFAULT_MODEL=openai/gpt-4o-mini
